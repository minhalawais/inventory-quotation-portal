{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "../app/**/*.ts",
    "../app/**/*.tsx",
    "../components/**/*.ts",
    "../components/**/*.tsx",
    "../hooks/**/*.ts",
    "../lib/**/*.ts",
    "../types/**/*.d.ts"
  ],
  "exclude": ["../src", "../node_modules"]
}
